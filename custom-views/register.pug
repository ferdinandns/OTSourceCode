extends master.pug

block head
  link(rel='stylesheet', href='https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,300;1,400&display=swap')
  style.
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --green-500: #16a34a;
      --green-400: #4ade80;
      --green-300: #86efac;
      --cyan-400:  #22d3ee;
      --slate-900: #0f172a;
      --slate-800: #1e293b;
      --slate-600: #475569;
      --slate-500: #64748b;
      --slate-400: #94a3b8;
      --slate-200: #e2e8f0;
      --slate-50:  #f8fafc;
      --amber-400: #fbbf24;
      --amber-500: #f59e0b;
      --amber-700: #b45309;
      --red-500:   #ef4444;
      --red-800:   #92400e;
      --white:     #ffffff;
      --navy:      #1a1f6e;

      --radius-card:   20px;
      --radius-inner:  12px;
      --shadow-card:   0 0 0 1px rgba(255,255,255,0.12), 0 24px 64px rgba(0,0,0,0.35), 0 4px 16px rgba(0,0,0,0.15);
      --shadow-logo:   drop-shadow(0 2px 10px rgba(0,0,0,0.65)) brightness(1.2) saturate(1.1);
      --shadow-green:  0 6px 20px rgba(22,163,74,0.35);
      --transition:    0.18s ease;
      --hero-width: clamp(480px, 52vw, 760px);
      --panel-width: clamp(420px, 38vw, 560px);
    }

    body {
      font-family: 'Plus Jakarta Sans', sans-serif !important;
      min-height: 100vh !important;
      background: var(--slate-900) !important;
      overflow: hidden !important;
    }

    .v-application--wrap > nav,
    .v-application--wrap > header { display: none !important; }
    .v-application--wrap { background: transparent !important; min-height: unset !important; }
    .v-main { padding: 0 !important; flex: none !important; }

    /* BACKGROUND */
    .cb-bg { position: fixed; inset: 0; z-index: 0; }
    .cb-bg-img { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; display: block; }

    /* PAGE LAYOUT */
    .cb-page {
      position: fixed; inset: 0; z-index: 100;
      display: flex; flex-direction: row; align-items: stretch;
      gap: 0; padding-bottom: 72px;
    }

    /* HERO */
    .cb-hero {
      flex: 1; display: flex; flex-direction: column;
      justify-content: center; padding: 64px 32px 64px 72px;
      max-width: var(--hero-width);
    }
    .cb-hero-eyebrow {
      font-size: 11px; font-weight: 700; letter-spacing: 3.5px;
      text-transform: uppercase; color: rgba(255,255,255,0.55); margin-bottom: 16px;
    }
    .cb-hero-welcome {
      font-size: clamp(18px, 2.4vw, 28px); font-weight: 400;
      color: rgba(255,255,255,0.88); line-height: 1.2; margin-bottom: 4px;
    }
    .cb-hero-title {
      font-size: clamp(48px, 7.5vw, 96px); font-weight: 900;
      color: var(--white); letter-spacing: -2px; line-height: 0.94;
      margin-bottom: 28px; text-shadow: 0 2px 40px rgba(0,0,0,0.4);
    }
    .cb-hero-sub {
      font-size: clamp(14px, 1.6vw, 18px); font-weight: 400;
      color: rgba(255,255,255,0.68); line-height: 1.6; max-width: 400px;
    }
    .cb-hero-line {
      width: 56px; height: 4px;
      background: linear-gradient(90deg, var(--green-400), var(--cyan-400));
      border-radius: 4px; margin-top: 32px;
    }

    /* PANEL — sama persis dengan login */
    .cb-panel {
      width: clamp(420px, 42vw, 560px);
      flex-shrink: 0; display: flex; flex-direction: column;
      justify-content: space-between; padding: 24px 36px 16px;
    }

    /* LOGOS */
    .cb-logos {
      display: flex; align-items: center; justify-content: center;
      gap: 24px; width: 100%; max-width: 100%;
      margin: 0 auto 12px; padding: 0;
    }
    .cb-logos img {
      height: clamp(48px, 5.5vw, 72px);
      width: auto; object-fit: contain; display: block;
      filter: var(--shadow-logo);
    }
    .cb-logo-sep {
      width: 1.5px; height: clamp(40px, 4.5vw, 58px);
      background: rgba(255,255,255,0.40); flex-shrink: 0;
    }

    /* CARD — sama persis dengan login */
    .cb-card {
      background: rgba(255,255,255,0.97); border-radius: var(--radius-card);
      padding: 28px 30px 20px; box-shadow: var(--shadow-card);
      display: flex; flex-direction: column;
      flex: 1; margin: 8px 0; min-height: 0; overflow: hidden;
    }

    /* CARD HEADER */
    .cb-card-header {
      display: flex; flex-direction: row; align-items: center;
      gap: 16px; margin-bottom: 20px; flex-shrink: 0;
    }
    .cb-cheetah-logo {
      width: clamp(44px, 4vw, 56px); height: clamp(44px, 4vw, 56px);
      object-fit: contain; flex-shrink: 0; display: block;
      filter: drop-shadow(0 2px 8px rgba(22,163,74,0.22));
    }
    .cb-card-header-text { display: flex; flex-direction: column; gap: 2px; }
    .cb-card-eyebrow {
      font-size: 9.5px; letter-spacing: 2.8px; text-transform: uppercase;
      display: flex; align-items: center; margin-bottom: 2px;
    }
    .cb-card-eyebrow-b { font-weight: 900; color: var(--slate-900); }
    .cb-card-eyebrow-l { font-weight: 300; color: var(--slate-400); }
    .cb-card-title {
      font-size: clamp(22px, 2.4vw, 30px); font-weight: 800;
      color: var(--slate-900); letter-spacing: -0.5px; line-height: 1.1;
    }
    .cb-card-sub { font-size: 11.5px; color: var(--slate-500); font-weight: 500; }

    /* FORM AREA — scrollable di dalam card */
    .cb-form-wrap {
      flex: 1; min-height: 0; overflow-y: auto; overflow-x: hidden;
      display: flex; flex-direction: column; gap: 0;
      padding-right: 2px;
    }
    .cb-form-wrap::-webkit-scrollbar { width: 4px; }
    .cb-form-wrap::-webkit-scrollbar-track { background: transparent; }
    .cb-form-wrap::-webkit-scrollbar-thumb { background: var(--slate-200); border-radius: 4px; }

    .cb-form { display: flex; flex-direction: column; gap: 10px; }

    /* FIELDS */
    .cb-field { display: flex; flex-direction: column; gap: 4px; }
    .cb-label {
      font-size: 10.5px; font-weight: 700; letter-spacing: 0.5px;
      text-transform: uppercase; color: var(--slate-500);
    }
    .cb-input-wrap {
      position: relative; display: flex; align-items: center;
    }
    .cb-input-icon {
      position: absolute; left: 12px; top: 50%; transform: translateY(-50%);
      color: var(--slate-400); font-size: 15px; pointer-events: none;
      transition: color var(--transition); display: flex; align-items: center;
    }
    .cb-input-wrap:focus-within .cb-input-icon { color: var(--green-500); }

    /* INPUT — sama dengan login .v-input__slot style */
    .cb-input {
      width: 100%; height: 44px; padding: 0 12px 0 38px;
      border: 1.5px solid var(--slate-200);
      border-radius: var(--radius-inner);
      background: var(--slate-50);
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 13px; color: var(--slate-900);
      outline: none;
      transition: border-color var(--transition), box-shadow var(--transition), background var(--transition);
      -webkit-appearance: none; appearance: none;
    }
    .cb-input:focus {
      border-color: var(--green-500);
      background: var(--white);
      box-shadow: 0 0 0 3px rgba(22,163,74,0.12);
    }
    .cb-input::placeholder { color: var(--slate-400); }
    .cb-input.has-eye { padding-right: 38px; }

    /* SELECT */
    .cb-select {
      width: 100%; height: 44px; padding: 0 36px 0 38px;
      border: 1.5px solid var(--slate-200);
      border-radius: var(--radius-inner);
      background: var(--slate-50);
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 13px; color: var(--slate-900);
      outline: none; cursor: pointer;
      transition: border-color var(--transition), box-shadow var(--transition), background var(--transition);
      -webkit-appearance: none; appearance: none;
    }
    .cb-select:focus {
      border-color: var(--green-500);
      background: var(--white);
      box-shadow: 0 0 0 3px rgba(22,163,74,0.12);
    }
    .cb-select-arrow {
      position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
      pointer-events: none; color: var(--slate-400);
      display: flex; align-items: center; transition: color var(--transition);
    }
    .cb-input-wrap:focus-within .cb-select-arrow { color: var(--green-500); }
    .cb-select option { color: var(--slate-900); background: var(--white); }
    .cb-select option[value=""] { color: var(--slate-400); }

    /* PASSWORD TOGGLE */
    .cb-eye-btn {
      position: absolute; right: 10px; top: 50%; transform: translateY(-50%);
      background: none; border: none; cursor: pointer; padding: 4px;
      color: var(--slate-400); display: flex; align-items: center;
      transition: color var(--transition);
    }
    .cb-eye-btn:hover { color: var(--slate-600); }

    /* PASSWORD STRENGTH */
    .cb-pwd-bar {
      height: 3px; border-radius: 2px; background: var(--slate-200);
      overflow: hidden; margin-top: 2px;
    }
    .cb-pwd-fill {
      height: 100%; width: 0%; border-radius: 2px;
      transition: width 0.3s ease, background 0.3s ease;
    }
    .cb-pwd-hint { font-size: 10px; color: var(--slate-400); }

    /* FIELD ERROR */
    .cb-field-err {
      font-size: 10.5px; color: var(--red-500); font-weight: 600;
      display: none; align-items: center; gap: 3px;
    }
    .cb-field-err.show { display: flex; }

    /* ALERT BOX */
    .cb-alert {
      padding: 10px 14px; border-radius: var(--radius-inner);
      font-size: 12px; font-weight: 600; display: none;
      align-items: flex-start; gap: 8px; line-height: 1.4;
      margin-bottom: 12px; flex-shrink: 0;
    }
    .cb-alert.show { display: flex; }
    .cb-alert-error   { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }
    .cb-alert-success { background: #f0fdf4; color: #166534; border: 1px solid #bbf7d0; }

    /* SUBMIT BUTTON — sama dengan login .v-btn.primary */
    .cb-btn {
      width: 100%; height: 46px; border: none; cursor: pointer;
      border-radius: var(--radius-inner);
      background: linear-gradient(135deg, var(--green-500) 0%, #15803d 100%);
      color: var(--white); font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 14px; font-weight: 700; letter-spacing: 0.2px;
      box-shadow: var(--shadow-green);
      transition: all var(--transition); margin-top: 4px;
      display: flex; align-items: center; justify-content: center; gap: 8px;
    }
    .cb-btn:hover:not(:disabled) {
      background: linear-gradient(135deg, #15803d 0%, #166534 100%);
      transform: translateY(-1px);
      box-shadow: 0 8px 28px rgba(22,163,74,0.42);
    }
    .cb-btn:disabled { opacity: 0.65; cursor: not-allowed; transform: none; }
    .cb-btn-spinner {
      width: 16px; height: 16px; border: 2px solid rgba(255,255,255,0.4);
      border-top-color: white; border-radius: 50%;
      animation: spin 0.7s linear infinite; display: none;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* LOGIN LINK — sama dengan login .cb-auth-box a style */
    .cb-login-link {
      text-align: center; font-size: 11.5px; color: var(--slate-500);
      font-weight: 500; flex-shrink: 0; margin-top: 10px;
    }
    .cb-login-link a {
      color: var(--green-500); font-weight: 700; text-decoration: none;
    }
    .cb-login-link a:hover { text-decoration: underline; }

    /* FOOTER — identik dengan login */
    .cb-footer {
      position: fixed; bottom: 0; left: 0; right: 0; z-index: 300;
      background: var(--navy); padding: 14px 40px 12px;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center; gap: 3px;
      border-top: 1px solid rgba(255,255,255,0.08);
    }
    .cb-footer-line1 {
      font-size: 13.5px; font-weight: 600;
      color: rgba(255,255,255,0.90); letter-spacing: 0.1px;
      text-align: center; line-height: 1.5;
    }
    .cb-footer-line1 strong { color: var(--green-400); font-weight: 800; }
    .cb-footer-line2 { font-size: 11px; color: #f87171; font-weight: 500; text-align: center; }

    /* RESPONSIVE — identik dengan login */
    @media (max-height: 640px) and (min-width: 769px) {
      .cb-page { padding-bottom: 54px; }
      .cb-hero { padding: 20px 28px 20px 48px; }
      .cb-hero-eyebrow { font-size: 9px; margin-bottom: 8px; }
      .cb-hero-welcome { font-size: 15px; }
      .cb-hero-title   { font-size: clamp(28px, 4.8vw, 46px); margin-bottom: 10px; }
      .cb-hero-sub     { font-size: 12px; max-width: 340px; }
      .cb-hero-line    { margin-top: 10px; height: 3px; }
      .cb-panel { width: clamp(390px, 41vw, 530px); padding: 10px 18px 8px 16px; }
      .cb-logos { gap: 20px; margin-bottom: 6px; }
      .cb-logos img  { height: clamp(36px, 3.8vw, 48px); }
      .cb-logo-sep   { height: clamp(28px, 3vw, 38px); }
      .cb-card { padding: 14px 20px 10px; margin: 4px 0; border-radius: 14px; }
      .cb-card-header { gap: 10px; margin-bottom: 10px; }
      .cb-cheetah-logo { width: 46px; height: 46px; }
      .cb-card-title { font-size: clamp(17px, 2vw, 22px); }
      .cb-card-sub   { font-size: 10px; }
      .cb-input, .cb-select { height: 38px; font-size: 12px; }
      .cb-btn { height: 40px; font-size: 13px; margin-top: 2px; }
      .cb-form { gap: 6px; }
      .cb-footer { padding: 8px 24px 7px; }
      .cb-footer-line1 { font-size: 11px; }
      .cb-footer-line2 { font-size: 9.5px; }
    }

    @media (min-height: 641px) and (max-height: 860px) and (min-width: 769px) {
      .cb-page { padding-bottom: 60px; }
      .cb-hero { padding: 48px 32px 48px 60px; }
      .cb-hero-title { font-size: clamp(40px, 6vw, 72px); }
      .cb-panel { width: clamp(410px, 41vw, 545px); padding: 16px 24px 10px 20px; }
      .cb-logos img { height: clamp(44px, 4.8vw, 60px); }
      .cb-logo-sep  { height: clamp(36px, 3.8vw, 48px); }
      .cb-card { padding: 24px 28px 18px; }
      .cb-cheetah-logo { width: 50px; height: 50px; }
      .cb-footer { padding: 11px 32px 9px; }
      .cb-footer-line1 { font-size: 12.5px; }
    }

    @media (min-width: 769px) and (max-width: 1366px) {
      .cb-panel { width: clamp(400px, 41vw, 540px); padding: 16px 24px 10px 18px; }
      .cb-logos img { height: clamp(44px, 4.5vw, 60px); }
      .cb-hero { padding: 48px 28px 48px 52px; }
    }

    @media (min-width: 769px) and (max-width: 900px) {
      .cb-panel { width: 370px; padding: 16px 18px 10px 14px; }
      .cb-hero  { padding: 48px 20px 48px 32px; }
      .cb-hero-sub { font-size: 13px; max-width: 300px; }
      .cb-cheetah-logo { width: 44px; height: 44px; }
      .cb-logos img { height: 44px; }
    }

    @media (max-width: 768px) {
      body { overflow: auto !important; }
      .cb-page {
        position: relative; inset: unset; width: 100%; height: auto; min-height: 100vh;
        flex-direction: column; align-items: center; justify-content: flex-start;
        padding: 0 0 76px; overflow-y: auto; gap: 0;
      }
      .cb-hero {
        flex: none; width: 100%; padding: 56px 28px 16px;
        text-align: center; align-items: center;
      }
      .cb-hero-eyebrow { font-size: 10px; letter-spacing: 2px; margin-bottom: 8px; }
      .cb-hero-welcome { font-size: 15px; }
      .cb-hero-title   { font-size: clamp(36px, 10vw, 56px); margin-bottom: 12px; }
      .cb-hero-sub     { font-size: 13px; max-width: 420px; }
      .cb-hero-line    { margin-top: 16px; }
      .cb-panel { width: 100%; max-width: 540px; flex: none; padding: 8px 20px 24px; justify-content: flex-start; }
      .cb-logos { justify-content: center; margin-bottom: 16px; gap: 24px; padding: 0 8px; }
      .cb-logos img  { height: clamp(40px, 10vw, 56px); }
      .cb-logo-sep   { height: clamp(32px, 8vw, 44px); }
      .cb-card { flex: none; padding: 22px 20px 18px; border-radius: 18px; margin: 0; min-height: unset; overflow: visible; }
      .cb-form-wrap { overflow: visible; flex: none; }
      .cb-card-header { gap: 12px; margin-bottom: 16px; }
      .cb-cheetah-logo { width: clamp(36px, 10vw, 44px); height: clamp(36px, 10vw, 44px); }
      .cb-card-title { font-size: clamp(20px, 5.5vw, 26px); }
      .cb-footer { padding: 10px 20px 8px; }
      .cb-footer-line1 { font-size: 11.5px; white-space: normal; }
      .cb-footer-line2 { font-size: 10px; }
    }

    @media (min-width: 600px) and (max-width: 768px) {
      .cb-hero { padding: 64px 44px 20px; }
      .cb-hero-title { font-size: clamp(42px, 8vw, 60px); }
      .cb-panel { max-width: 560px; padding: 8px 36px 28px; }
      .cb-card { padding: 26px 24px 20px; }
      .cb-logos img { height: clamp(44px, 8vw, 56px); }
      .cb-cheetah-logo { width: 52px; height: 52px; }
      .cb-footer-line1 { font-size: 12px; }
    }

    @media (max-width: 440px) {
      .cb-hero { padding: 40px 16px 14px; }
      .cb-hero-title { font-size: clamp(30px, 11vw, 44px); }
      .cb-hero-sub   { font-size: 12px; }
      .cb-panel { padding: 6px 12px 18px; }
      .cb-card  { padding: 20px 14px 16px; border-radius: 14px; }
      .cb-logos img  { height: clamp(32px, 9vw, 42px); }
      .cb-logo-sep   { height: clamp(24px, 7vw, 34px); }
      .cb-cheetah-logo { width: 38px; height: 38px; }
      .cb-card-title { font-size: clamp(18px, 5vw, 22px); }
      .cb-footer-line1 { font-size: 10px; }
      .cb-footer-line2 { font-size: 9px; }
    }

block body
  .cb-bg
    img.cb-bg-img(
      src='/loginpage.png' alt=''
      onerror="this.style.background='linear-gradient(135deg,#0f4c28,#0c3547)'"
    )

  .cb-page

    .cb-hero
      p.cb-hero-eyebrow Knowledge Management System
      p.cb-hero-welcome Join
      h1.cb-hero-title Cheetah Book
      p.cb-hero-sub Buat akun dan mulai akses platform Knowledge Management Hub perusahaan.
      .cb-hero-line

    .cb-panel

      .cb-logos
        img(src='/bintang_toedjoe_logo.webp' alt='PT Bintang Toedjoe' onerror="this.remove()")
        .cb-logo-sep
        img(src='/kch.png' alt='Kalbe' onerror="this.remove()")

      .cb-card

        .cb-card-header
          img.cb-cheetah-logo(
            src='/logocheetah.png'
            alt='Cheetah Book'
            onerror="this.style.display='none'"
          )
          .cb-card-header-text
            .cb-card-eyebrow
              span.cb-card-eyebrow-b CHEETAH
              span.cb-card-eyebrow-l &nbsp;BOOK
            h2.cb-card-title Buat Akun
            p.cb-card-sub Isi form di bawah untuk mendaftar

        #cb-alert.cb-alert

        .cb-form-wrap
          .cb-form

            .cb-field
              label.cb-label(for='cb-email') Email Address
              .cb-input-wrap
                input#cb-email.cb-input(
                  type='email'
                  placeholder='Masukan Email'
                  autocomplete='email'
                  required
                )
                span.cb-input-icon
                  svg(width='15' height='15' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round')
                    rect(x='2' y='4' width='20' height='16' rx='2')
                    path(d='m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7')
              span#cb-email-err.cb-field-err Email tidak valid

            .cb-field
              label.cb-label(for='cb-password') Password
              .cb-input-wrap
                input#cb-password.cb-input.has-eye(
                  type='password'
                  placeholder='Min. 8 karakter'
                  autocomplete='new-password'
                  required
                )
                span.cb-input-icon
                  svg(width='15' height='15' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round')
                    rect(x='3' y='11' width='18' height='11' rx='2' ry='2')
                    path(d='M7 11V7a5 5 0 0 1 10 0v4')
                button.cb-eye-btn(type='button' id='cb-eye1' tabindex='-1' aria-label='Toggle password')
                  svg(width='15' height='15' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round')
                    path(d='M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z')
                    circle(cx='12' cy='12' r='3')
              .cb-pwd-bar
                #cb-pwd-fill.cb-pwd-fill
              span#cb-pwd-hint.cb-pwd-hint Masukkan password
              span#cb-password-err.cb-field-err Password minimal 8 karakter

            .cb-field
              label.cb-label(for='cb-verify') Konfirmasi Password
              .cb-input-wrap
                input#cb-verify.cb-input.has-eye(
                  type='password'
                  placeholder='Ulangi password'
                  autocomplete='new-password'
                  required
                )
                span.cb-input-icon
                  svg(width='15' height='15' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round')
                    path(d='M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z')
                button.cb-eye-btn(type='button' id='cb-eye2' tabindex='-1' aria-label='Toggle verify password')
                  svg(width='15' height='15' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round')
                    path(d='M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z')
                    circle(cx='12' cy='12' r='3')
              span#cb-verify-err.cb-field-err Password tidak cocok

            .cb-field
              label.cb-label(for='cb-name') Nama Lengkap
              .cb-input-wrap
                input#cb-name.cb-input(
                  type='text'
                  placeholder='Nama kamu'
                  autocomplete='name'
                  required
                )
                span.cb-input-icon
                  svg(width='15' height='15' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round')
                    path(d='M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2')
                    circle(cx='12' cy='7' r='4')
              span#cb-name-err.cb-field-err Nama tidak boleh kosong

            .cb-field
              label.cb-label(for='cb-role') Role / Jabatan
              .cb-input-wrap
                select#cb-role.cb-select(required)
                  option(value='') -- Pilih Role --
                  if groups && groups.length
                    each group in groups
                      option(value=group.id)= group.name
                  else
                    option(disabled) Tidak ada group tersedia
                span.cb-input-icon
                  svg(width='15' height='15' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round')
                    path(d='M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2')
                    circle(cx='9' cy='7' r='4')
                    path(d='M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75')
                span.cb-select-arrow
                  svg(width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round')
                    polyline(points='6 9 12 15 18 9')
              span#cb-role-err.cb-field-err Pilih role kamu

            button#cb-submit.cb-btn(type='button')
              span#cb-btn-spinner.cb-btn-spinner
              span#cb-btn-text REGISTER

          .cb-login-link
            | Sudah punya akun?&nbsp;
            a(href='/login') Login instead

      div(style='height:4px;flex-shrink:0;')

