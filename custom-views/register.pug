  script.
    (function () {
      'use strict';

      var emailEl    = document.getElementById('cb-email');
      var pwdEl      = document.getElementById('cb-password');
      var verifyEl   = document.getElementById('cb-verify');
      var nameEl     = document.getElementById('cb-name');
      var roleEl     = document.getElementById('cb-role');
      var submitBtn  = document.getElementById('cb-submit');
      var alertBox   = document.getElementById('cb-alert');
      var pwdFill    = document.getElementById('cb-pwd-fill');
      var pwdHint    = document.getElementById('cb-pwd-hint');
      var btnText    = document.getElementById('cb-btn-text');
      var btnSpinner = document.getElementById('cb-btn-spinner');

      function togglePwd(inputEl, btn) {
        if (!inputEl || !btn) return;
        btn.addEventListener('click', function () {
          var show = inputEl.type === 'password';
          inputEl.type = show ? 'text' : 'password';
          btn.style.opacity = show ? '1' : '0.5';
        });
      }
      togglePwd(pwdEl,    document.getElementById('cb-eye1'));
      togglePwd(verifyEl, document.getElementById('cb-eye2'));

      function pwdStrength(val) {
        var score = 0;
        if (val.length >= 8)           score++;
        if (val.length >= 12)          score++;
        if (/[A-Z]/.test(val))         score++;
        if (/[0-9]/.test(val))         score++;
        if (/[^A-Za-z0-9]/.test(val))  score++;
        return score;
      }
      var strengthColor = ['#ef4444', '#f97316', '#eab308', '#22c55e', '#16a34a'];
      var strengthLabel = ['Sangat Lemah', 'Lemah', 'Cukup', 'Kuat', 'Sangat Kuat'];

      if (pwdEl) {
        pwdEl.addEventListener('input', function () {
          var v = pwdEl.value;
          var s = v.length === 0 ? -1 : pwdStrength(v);
          if (s < 0) {
            pwdFill.style.width = '0%';
            pwdHint.textContent = 'Masukkan password';
            pwdHint.style.color = 'var(--slate-400)';
          } else {
            pwdFill.style.width = ((s + 1) * 20) + '%';
            pwdFill.style.background = strengthColor[s];
            pwdHint.textContent = strengthLabel[s];
            pwdHint.style.color = strengthColor[s];
          }
        });
      }

      function showErr(id, show) {
        var el = document.getElementById(id);
        if (el) el.classList.toggle('show', show);
      }

      function clearErrors() {
        ['cb-email-err', 'cb-password-err', 'cb-verify-err', 'cb-name-err', 'cb-role-err']
          .forEach(function (id) { showErr(id, false); });
        setAlert('', '');
      }

      function setAlert(msg, type) {
        alertBox.textContent = msg;
        alertBox.className = 'cb-alert';
        if (msg) {
          alertBox.classList.add('show');
          alertBox.classList.add(type === 'success' ? 'cb-alert-success' : 'cb-alert-error');
        }
      }

      function setLoading(loading) {
        submitBtn.disabled = loading;
        btnText.textContent = loading ? 'Processing...' : 'REGISTER';
        btnSpinner.style.display = loading ? 'block' : 'none';
      }

      function validate() {
        var ok     = true;
        var email  = emailEl.value.trim();
        var pwd    = pwdEl.value;
        var verify = verifyEl.value;
        var name   = nameEl.value.trim();
        var role   = roleEl.value;

        if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          showErr('cb-email-err', true); ok = false;
        }
        if (!pwd || pwd.length < 8) {
          showErr('cb-password-err', true); ok = false;
        }
        if (pwd !== verify) {
          showErr('cb-verify-err', true); ok = false;
        }
        if (!name) {
          showErr('cb-name-err', true); ok = false;
        }
        if (!role) {
          showErr('cb-role-err', true); ok = false;
        }
        return ok;
      }

      [emailEl, pwdEl, verifyEl, nameEl, roleEl].forEach(function (el) {
        if (!el) return;
        el.addEventListener('input',  function () { clearErrors(); });
        el.addEventListener('change', function () { clearErrors(); });
      });

      submitBtn.addEventListener('click', function () {
        clearErrors();
        if (!validate()) return;

        var email     = emailEl.value.trim();
        var pwd       = pwdEl.value;
        var name      = nameEl.value.trim();
        var groupName = roleEl.options[roleEl.selectedIndex].text;
        var displayName = name + ' [' + groupName + ']';

        setLoading(true);

        fetch('/graphql', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({
            query: 'mutation($email: String!, $password: String!, $name: String!) { authentication { register(email: $email, password: $password, name: $name) { responseResult { succeeded errorCode message } } } }',
            variables: { email: email, password: pwd, name: displayName }
          })
        })
        .then(function (res) { return res.json(); })
        .then(function (data) {
          setLoading(false);
          var result = data && data.data && data.data.authentication &&
                       data.data.authentication.register &&
                       data.data.authentication.register.responseResult;
          if (result && result.succeeded) {
            setAlert('Akun berhasil dibuat. Silahkan cek akun email yang didaftar untuk verifikasi', 'success');
            submitBtn.disabled = true;
            setTimeout(function () { window.location.href = '/login'; }, 10000);
          } else {
            var msg = (result && result.message) || 'Registrasi gagal. Silakan coba lagi.';
            if (msg.indexOf('already') !== -1 || msg.indexOf('exist') !== -1) {
              msg = 'Email sudah terdaftar. Gunakan email lain atau login.';
            }
            setAlert(msg, 'error');
          }
        })
        .catch(function (err) {
          setLoading(false);
          setAlert('Koneksi gagal. Periksa jaringan dan coba lagi.', 'error');
          console.error('Register error:', err);
        });
      });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' && !submitBtn.disabled) submitBtn.click();
      });

    })();
