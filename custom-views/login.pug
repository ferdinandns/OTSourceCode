extends master.pug

block head
  link(rel='stylesheet', href='https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,300;1,400&display=swap')
  style.
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --green-500: #16a34a;
      --green-400: #4ade80;
      --green-300: #86efac;
      --cyan-400:  #22d3ee;
      --slate-900: #0f172a;
      --slate-800: #1e293b;
      --slate-600: #475569;
      --slate-500: #64748b;
      --slate-400: #94a3b8;
      --slate-200: #e2e8f0;
      --slate-50:  #f8fafc;
      --amber-400: #fbbf24;
      --amber-500: #f59e0b;
      --amber-700: #b45309;
      --red-800:   #92400e;
      --white:     #ffffff;
      --navy:      #1a1f6e;

      --radius-card:   20px;
      --radius-inner:  12px;
      --shadow-card:   0 0 0 1px rgba(255,255,255,0.12), 0 24px 64px rgba(0,0,0,0.35), 0 4px 16px rgba(0,0,0,0.15);
      --shadow-logo:   drop-shadow(0 2px 10px rgba(0,0,0,0.65)) brightness(1.2) saturate(1.1);
      --shadow-green:  0 6px 20px rgba(22,163,74,0.35);
      --transition:    0.18s ease;
      --panel-shift: clamp(-80px, -6vw, -24px);
      --hero-width: clamp(480px, 52vw, 760px);
      --panel-width: clamp(420px, 38vw, 560px);
    }

    body {
      font-family: 'Plus Jakarta Sans', sans-serif !important;
      min-height: 100vh !important;
      background: var(--slate-900) !important;
      overflow: hidden !important;
    }

    .v-application--wrap > nav,
    .v-application--wrap > header { display: none !important; }
    .v-application--wrap { background: transparent !important; min-height: unset !important; }
    .v-main { padding: 0 !important; flex: none !important; }

    /* BACKGROUND */
    .cb-bg { position: fixed; inset: 0; z-index: 0; }
    .cb-bg-img { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; display: block; }

    /* PAGE LAYOUT*/
    .cb-page {
      position: fixed; inset: 0; z-index: 100;
      display: flex; flex-direction: row; align-items: stretch;
      gap: 0; padding-bottom: 72px;
    }

    /* HERO */
    .cb-hero {
      flex: 1; display: flex; flex-direction: column;
      justify-content: center; padding: 64px 32px 64px 72px;
      max-width: var(--hero-width);
    }
    .cb-hero-eyebrow {
      font-size: 11px; font-weight: 700; letter-spacing: 3.5px;
      text-transform: uppercase; color: rgba(255,255,255,0.55); margin-bottom: 16px;
    }
    .cb-hero-welcome {
      font-size: clamp(18px, 2.4vw, 28px); font-weight: 400;
      color: rgba(255,255,255,0.88); line-height: 1.2; margin-bottom: 4px;
    }
    .cb-hero-title {
      font-size: clamp(48px, 7.5vw, 96px); font-weight: 900;
      color: var(--white); letter-spacing: -2px; line-height: 0.94;
      margin-bottom: 28px; text-shadow: 0 2px 40px rgba(0,0,0,0.4);
    }
    .cb-hero-sub {
      font-size: clamp(14px, 1.6vw, 18px); font-weight: 400;
      color: rgba(255,255,255,0.68); line-height: 1.6; max-width: 400px;
    }
    .cb-hero-line {
      width: 56px; height: 4px;
      background: linear-gradient(90deg, var(--green-400), var(--cyan-400));
      border-radius: 4px; margin-top: 32px;
    }

    /* PANEL */
    .cb-panel {
      width: clamp(420px, 42vw, 560px);
      flex-shrink:0; display:flex; flex-direction:column;
      justify-content:space-between; padding:24px 36px 16px;
    }

    /* LOGOS */
    .cb-logos {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 24px;
      width: 100%;
      max-width: 100%;
      margin: 0 auto 12px;
      padding: 0;
    }
    .cb-logos img {
      height: clamp(48px, 5.5vw, 72px);
      width: auto; object-fit: contain; display: block;
      filter: var(--shadow-logo);
    }
    .cb-logo-sep {
      width: 1.5px; height: clamp(40px, 4.5vw, 58px);
      background: rgba(255,255,255,0.40); flex-shrink: 0;
    }

    /* CARD */
    .cb-card {
      background: rgba(255,255,255,0.97); border-radius: var(--radius-card);
      padding: 28px 30px 20px; box-shadow: var(--shadow-card);
      display: flex; flex-direction: column;
      flex: 1; margin: 8px 0; min-height: 0; overflow: hidden;
    }

    /* CARD HEADER */
    .cb-card-header {
      display: flex; flex-direction: row; align-items: center;
      gap: 16px; margin-bottom: 20px;
    }

    .cb-cheetah-logo {
      width: clamp(44px, 4vw, 56px);
      height: clamp(44px, 4vw, 56px);
      object-fit: contain; flex-shrink: 0; display: block;
      filter: drop-shadow(0 2px 8px rgba(22,163,74,0.22));
    }

    .cb-card-header-text { display: flex; flex-direction: column; gap: 2px; }
    .cb-card-eyebrow {
      font-size: 9.5px; letter-spacing: 2.8px; text-transform: uppercase;
      display: flex; align-items: center; margin-bottom: 2px;
    }
    .cb-card-eyebrow-b { font-weight: 900; color: var(--slate-900); }
    .cb-card-eyebrow-l { font-weight: 300; color: var(--slate-400); }
    .cb-card-title {
      font-size: clamp(22px, 2.4vw, 30px); font-weight: 800;
      color: var(--slate-900); letter-spacing: -0.5px; line-height: 1.1;
    }
    .cb-card-sub { font-size: 11.5px; color: var(--slate-500); font-weight: 500; }

    /* AUTH BOX */
    .cb-auth-box {
      flex: 1; min-height: 0; overflow: hidden; position: relative; width: 100%;
    }
    .cb-auth-box .v-application,
    .cb-auth-box .v-application--wrap,
    .cb-auth-box .v-main,
    .cb-auth-box .v-main__wrap,
    .cb-auth-box .v-container {
      width: 100% !important; max-width: 100% !important; min-width: unset !important;
      margin: 0 !important; padding: 0 !important;
      background: transparent !important; overflow: hidden !important;
    }
    .cb-auth-box .v-card {
      width: 100% !important; max-width: 100% !important;
      margin: 0 !important; padding: 0 !important;
      box-shadow: none !important; background: transparent !important;
      border: none !important; border-radius: 0 !important; overflow: hidden !important;
    }
    .cb-auth-box .v-card__text {
      padding: 0 !important; background: transparent !important;
      overflow: hidden !important; display: flex !important;
      flex-direction: column !important; height: 100% !important;
    }

    /* Hide Wiki.js noise — v-sheet DIHAPUS dari sini agar tidak konflik dengan v-alert */
    .cb-auth-box .v-card__title,
    .cb-auth-box .v-card__subtitle,
    .cb-auth-box .v-divider,
    .cb-auth-box .v-list,
    .cb-auth-box .v-list-item,
    .cb-auth-box .overline,
    .cb-auth-box .subtitle-1 { display: none !important; }

    .cb-auth-box .v-card__text > .text-center:not(:has(a)),
    .cb-auth-box .v-card__text > div.pa-3,
    .cb-auth-box .v-card__text > div.pa-4,
    .cb-auth-box .v-card__text > div:has(.v-avatar),
    .cb-auth-box .v-card__text > div:has(h1),
    .cb-auth-box .v-card__text > div:has(h2),
    .cb-auth-box .v-card__text > div:has(h3),
    .cb-auth-box .v-card__text > div:has(.v-image),
    .cb-auth-box .v-card__text > div:has(.body-1),
    .cb-auth-box .v-card__text > div:has(.body-2):not(:has(a)),
    .cb-auth-box .v-card__text > div:has(.subtitle-2):not(:has(input)):not(:has(button)):not(:has(a)) {
      display: none !important; height: 0 !important; overflow: hidden !important;
      margin: 0 !important; padding: 0 !important; visibility: hidden !important;
    }

    .cb-auth-box .v-input__slot::before,
    .cb-auth-box .v-input__slot::after { display: none !important; border: none !important; }

    /* INPUT */
    .cb-auth-box .v-input__slot {
      border: 1.5px solid var(--slate-200) !important;
      background: var(--slate-50) !important;
      border-radius: var(--radius-inner) !important;
      box-shadow: none !important; padding: 0 12px !important;
      min-height: 44px !important; max-height: 44px !important;
      transition: border-color var(--transition), box-shadow var(--transition) !important;
    }
    .cb-auth-box .v-input--is-focused .v-input__slot {
      border-color: var(--green-500) !important; background: var(--white) !important;
      box-shadow: 0 0 0 3px rgba(22,163,74,0.12) !important;
    }
    .cb-auth-box .v-text-field { margin-top: 8px !important; margin-bottom: 0 !important; }
    .cb-auth-box .v-text-field > .v-input__control > .v-input__slot { margin-bottom: 0 !important; }
    .cb-auth-box .v-text-field__details { padding: 2px !important; min-height: 14px !important; max-height: 14px !important; }
    .cb-auth-box .v-input { margin-bottom: 0 !important; }
    .cb-auth-box .v-text-field input {
      font-size: 13px !important; font-family: 'Plus Jakarta Sans', sans-serif !important;
      color: var(--slate-900) !important; caret-color: var(--green-500) !important;
      padding: 0 !important; max-height: 44px !important;
    }
    .cb-auth-box .v-label { font-size: 12.5px !important; color: var(--slate-400) !important; font-family: 'Plus Jakarta Sans', sans-serif !important; }
    .cb-auth-box .v-label--active { color: var(--green-500) !important; font-size: 10px !important; font-weight: 700 !important; }
    .cb-auth-box .v-input__prepend-inner,
    .cb-auth-box .v-input__append-inner { margin-top: auto !important; margin-bottom: auto !important; }
    .cb-auth-box .v-input__prepend-inner .v-icon { font-size: 16px !important; color: var(--slate-400) !important; }
    .cb-auth-box .v-input--is-focused .v-input__prepend-inner .v-icon { color: var(--green-500) !important; }
    .cb-auth-box .v-input__append-inner .v-icon { font-size: 16px !important; color: var(--slate-400) !important; }

    /* BUTTON */
    .cb-auth-box .v-btn { margin: 14px 0 0 !important; width: 100% !important; }
    .cb-auth-box .v-btn.primary {
      height: 46px !important; border-radius: var(--radius-inner) !important;
      background: linear-gradient(135deg, var(--green-500) 0%, #15803d 100%) !important;
      font-weight: 700 !important; text-transform: none !important; font-size: 14px !important;
      letter-spacing: 0.2px !important; box-shadow: var(--shadow-green) !important;
      width: 100% !important; color: var(--white) !important;
      transition: all var(--transition) !important;
    }
    .cb-auth-box .v-btn.primary:hover {
      background: linear-gradient(135deg, #15803d 0%, #166534 100%) !important;
      transform: translateY(-1px) !important;
      box-shadow: 0 8px 28px rgba(22,163,74,0.42) !important;
    }
    .cb-auth-box .v-btn__content {
      font-family: 'Plus Jakarta Sans', sans-serif !important;
      font-size: 14px !important; font-weight: 700 !important; text-transform: none !important;
    }

    /* LINKS */
    .cb-auth-box a,
    .cb-auth-box .caption a,
    .cb-auth-box .v-card__text a {
      color: var(--green-500) !important; font-weight: 600 !important;
      text-decoration: none !important; font-size: 11.5px !important;
      display: inline-block !important; visibility: visible !important; opacity: 1 !important;
    }
    .cb-auth-box .v-card__text > div:has(> a),
    .cb-auth-box .v-card__text > .caption,
    .cb-auth-box .v-card__text > .text-center:has(a) {
      display: flex !important; justify-content: center !important; align-items: center !important;
      margin-top: 10px !important; flex-shrink: 0 !important; height: auto !important;
      max-height: none !important; overflow: visible !important;
      visibility: visible !important; opacity: 1 !important;
    }

    /* Hide spinner loading saat login — hanya target atom-spinner & subtitle loading */
    .cb-auth-box .atom-spinner { opacity: 0 !important; width: 0 !important; height: 0 !important; }
    .cb-auth-box .subtitle-1.white--text { display: none !important; }
    .cb-auth-box .caption.white--text { display: none !important; }

    /* Hide background bawaan Wiki.js di dalam .login */
    .cb-auth-box .login { background-image: none !important; background: transparent !important; }
    .cb-auth-box .login-sd { background: transparent !important; box-shadow: none !important; }

    /* FIX ZOOM: auth-box dan card menyesuaikan zoom level */
    .cb-auth-box {
      overflow-y: auto !important;
    }
    .cb-auth-box .v-card__text {
      overflow-y: auto !important;
      height: auto !important;
      min-height: 0 !important;
    }

    /* Pastikan link Forgot password & Create account selalu terlihat */
    .cb-auth-box .v-card__text > div:has(> a),
    .cb-auth-box .v-card__text > .caption,
    .cb-auth-box .v-card__text > .text-center:has(a) {
      flex-shrink: 0 !important;
      min-height: fit-content !important;
    }

    /* FIX: card scrollable saat konten melebihi tinggi */
    .cb-card {
      overflow-y: auto !important;
    }

    /* FOOTER */
    .cb-footer {
      position: fixed; bottom: 0; left: 0; right: 0; z-index: 300;
      background: var(--navy); padding: 14px 40px 12px;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center; gap: 3px;
      border-top: 1px solid rgba(255,255,255,0.08);
    }
    .cb-footer-line1 {
      font-size: 13.5px; font-weight: 600;
      color: rgba(255,255,255,0.90); letter-spacing: 0.1px;
      text-align: center; line-height: 1.5;
    }
    .cb-footer-line1 strong { color: var(--green-400); font-weight: 800; }
    .cb-footer-line2 { font-size: 11px; color: #f87171; font-weight: 500; text-align: center; }

    @media (max-height: 640px) and (min-width: 769px) {
      .cb-page { padding-bottom: 54px; }
      .cb-hero { padding: 20px 28px 20px 48px; }
      .cb-hero-eyebrow { font-size: 9px; margin-bottom: 8px; }
      .cb-hero-welcome { font-size: 15px; }
      .cb-hero-title   { font-size: clamp(28px, 4.8vw, 46px); margin-bottom: 10px; }
      .cb-hero-sub     { font-size: 12px; max-width: 340px; }
      .cb-hero-line    { margin-top: 10px; height: 3px; }
      .cb-panel { width: clamp(390px, 41vw, 530px); padding: 10px 18px 8px 16px; }
      .cb-logos { gap: 20px; margin-bottom: 6px; }
      .cb-logos img    { height: clamp(36px, 3.8vw, 48px); }
      .cb-logo-sep     { height: clamp(28px, 3vw, 38px); }
      .cb-card { padding: 14px 20px 10px; margin: 4px 0; border-radius: 14px; overflow-y: auto; }
      .cb-card-header { gap: 10px; margin-bottom: 10px; }
      .cb-cheetah-logo { width: 46px; height: 46px; }
      .cb-card-title   { font-size: clamp(17px, 2vw, 22px); }
      .cb-card-sub     { font-size: 10px; }
      .cb-auth-box { overflow: visible; min-height: 0; flex: none; }
      .cb-auth-box .v-card__text { height: auto !important; overflow: visible !important; }
      .cb-auth-box .v-input__slot { min-height: 36px !important; max-height: 36px !important; }
      .cb-auth-box .v-btn.primary { height: 38px !important; }
      .cb-auth-box .v-text-field { margin-top: 4px !important; }
      .cb-auth-box .v-btn { margin: 6px 0 0 !important; }
      .cb-auth-box .v-text-field__details { min-height: 10px !important; max-height: 10px !important; }
      .cb-footer { padding: 8px 24px 7px; }
      .cb-footer-line1 { font-size: 11px; }
      .cb-footer-line2 { font-size: 9.5px; }
    }

    @media (min-height: 641px) and (max-height: 860px) and (min-width: 769px) {
      .cb-page { padding-bottom: 60px; }
      .cb-hero { padding: 48px 32px 48px 60px; }
      .cb-hero-title { font-size: clamp(40px, 6vw, 72px); }
      .cb-panel { width: clamp(410px, 41vw, 545px); padding: 16px 24px 10px 20px; }
      .cb-logos img { height: clamp(44px, 4.8vw, 60px); }
      .cb-logo-sep  { height: clamp(36px, 3.8vw, 48px); }
      .cb-card { padding: 24px 28px 18px; }
      .cb-cheetah-logo { width: 50px; height: 50px; }
      .cb-footer { padding: 11px 32px 9px; }
      .cb-footer-line1 { font-size: 12.5px; }
    }

    @media (min-width: 769px) and (max-width: 1366px) {
      .cb-panel { width: clamp(400px, 41vw, 540px); padding: 16px 24px 10px 18px; }
      .cb-logos img { height: clamp(44px, 4.5vw, 60px); }
      .cb-hero { padding: 48px 28px 48px 52px; }
    }

    @media (min-width: 769px) and (max-width: 900px) {
      .cb-panel { width: 370px; padding: 16px 18px 10px 14px; }
      .cb-hero  { padding: 48px 20px 48px 32px; }
      .cb-hero-sub { font-size: 13px; max-width: 300px; }
      .cb-cheetah-logo { width: 44px; height: 44px; }
      .cb-logos img { height: 44px; }
    }

    @media (max-width: 768px) {
      body { overflow: auto !important; }
      .cb-bg::after { background: rgba(8,14,30,0.75); }
      .cb-page {
        position: relative; inset: unset; width: 100%; height: auto; min-height: 100vh;
        flex-direction: column; align-items: center; justify-content: flex-start;
        padding: 0 0 76px; overflow-y: auto; gap: 0;
      }
      .cb-hero {
        flex: none; width: 100%; padding: 56px 28px 16px;
        text-align: center; align-items: center;
      }
      .cb-hero-eyebrow { font-size: 10px; letter-spacing: 2px; margin-bottom: 8px; }
      .cb-hero-welcome { font-size: 15px; }
      .cb-hero-title   { font-size: clamp(36px, 10vw, 56px); margin-bottom: 12px; }
      .cb-hero-sub     { font-size: 13px; max-width: 420px; }
      .cb-hero-line    { margin-top: 16px; }
      .cb-panel { width: 100%; max-width: 540px; flex: none; padding: 8px 20px 24px; justify-content: flex-start; }
      .cb-logos { justify-content: center; margin-bottom: 16px; gap: 24px; padding: 0 8px; }
      .cb-logos img    { height: clamp(40px, 10vw, 56px); }
      .cb-logo-sep     { height: clamp(32px, 8vw, 44px); }
      .cb-card { flex: none; padding: 22px 20px 18px; border-radius: 18px; margin: 0; min-height: unset; overflow: visible; }
      .cb-card-header { gap: 12px; margin-bottom: 16px; }
      .cb-cheetah-logo { width: clamp(36px, 10vw, 44px); height: clamp(36px, 10vw, 44px); }
      .cb-card-title   { font-size: clamp(20px, 5.5vw, 26px); }
      .cb-auth-box { min-height: 180px; overflow: visible; }
      .cb-auth-box .v-card__text { height: auto !important; overflow: visible !important; }
      .cb-footer { padding: 10px 20px 8px; }
      .cb-footer-line1 { font-size: 11.5px; white-space: normal; }
      .cb-footer-line2 { font-size: 10px; }
    }

    @media (min-width: 600px) and (max-width: 768px) {
      .cb-hero { padding: 64px 44px 20px; }
      .cb-hero-title { font-size: clamp(42px, 8vw, 60px); }
      .cb-panel { max-width: 560px; padding: 8px 36px 28px; }
      .cb-card { padding: 26px 24px 20px; }
      .cb-logos img { height: clamp(44px, 8vw, 56px); }
      .cb-cheetah-logo { width: 52px; height: 52px; }
      .cb-footer-line1 { font-size: 12px; }
    }

    @media (max-width: 440px) {
      .cb-hero { padding: 40px 16px 14px; }
      .cb-hero-title { font-size: clamp(30px, 11vw, 44px); }
      .cb-hero-sub   { font-size: 12px; }
      .cb-panel { padding: 6px 12px 18px; }
      .cb-card  { padding: 20px 14px 16px; border-radius: 14px; }
      .cb-logos img  { height: clamp(32px, 9vw, 42px); }
      .cb-logo-sep   { height: clamp(24px, 7vw, 34px); }
      .cb-cheetah-logo { width: 38px; height: 38px; }
      .cb-card-title { font-size: clamp(18px, 5vw, 22px); }
      .cb-footer-line1 { font-size: 10px; }
      .cb-footer-line2 { font-size: 9px; }
    }

block body
  .cb-bg
    img.cb-bg-img(
      src='/loginpage.png' alt=''
      onerror="this.style.background='linear-gradient(135deg,#0f4c28,#0c3547)'"
    )

  .cb-page

    .cb-hero
      p.cb-hero-eyebrow Knowledge Management System
      p.cb-hero-welcome Welcome to
      h1.cb-hero-title Cheetah Book
      p.cb-hero-sub Platform Digital Knowledge Management Hub
      .cb-hero-line

    .cb-panel

      .cb-logos
        img(src='/bintang_toedjoe_logo.webp' alt='PT Bintang Toedjoe' onerror="this.remove()")
        .cb-logo-sep
        img(src='/kch.png' alt='Kalbe' onerror="this.remove()")

      .cb-card

        .cb-card-header
          img.cb-cheetah-logo(
            src='/logocheetah.png'
            alt='Cheetah Book'
            onerror="this.style.display='none'"
          )
          .cb-card-header-text
            .cb-card-eyebrow
              span.cb-card-eyebrow-b CHEETAH
              span.cb-card-eyebrow-l &nbsp;BOOK
            h2.cb-card-title Welcome!
            p.cb-card-sub Please sign in to your account

        .cb-auth-box
          #root(style='background:transparent!important;width:100%!important;min-width:unset!important;max-width:100%!important;height:100%!important;overflow:hidden!important;')
            login(bg-url=bgUrl hide-local=hideLocal change-pwd-continuation-token=changePwdContinuationToken)

      div(style='height:4px;flex-shrink:0;')

  .cb-footer
    p.cb-footer-line1
      | Developed by #[strong Maheswari Salsabil] In Collaboration With  Kalbe Consumer Health &amp; President University
    p.cb-footer-line2 ©2026 Kalbe Consumer Health. All Rights Reserved

  script.
    document.body.classList.add('cb-login')

    ;(function () {
      function removeCbLogin() {
        document.body.classList.remove('cb-login')
        var nav = document.querySelector('.v-application--wrap > nav')
        var hdr = document.querySelector('.v-application--wrap > header')
        if (nav) nav.style.removeProperty('display')
