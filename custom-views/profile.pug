extends master.pug

block head
  style.
    .exit-btn {
      position: fixed;
      top: 0;
      right: 120px;
      z-index: 9999;
      display: flex;
      align-items: center;
      gap: 8px;
      height: 64px;
      padding: 0 16px;
      color: #fff;
      text-decoration: none;
      font-family: Roboto, sans-serif;
      font-size: 0.875rem;
      font-weight: 500;
      letter-spacing: 0.08em;
      opacity: 0.7;
      transition: opacity 0.2s;
      white-space: nowrap;
    }
    .exit-btn:hover { opacity: 1; }
    @media (max-width: 960px) {
      .exit-btn {
        right: auto;
        left: 50%;
        transform: translateX(-50%);
        gap: 6px;
        padding: 0 12px;
      }
    }

block body
  #root
    a.exit-btn(href='/' onmouseover='this.style.opacity=1' onmouseout='this.style.opacity=0.7')
      svg(width='18' height='18' viewBox='0 0 24 24' fill='white')
        path(d='M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z')
      | EXIT
    profile